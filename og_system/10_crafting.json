            "on": "prepare",
            "to": "creation",
            "procedure": "toolCheck"
          },
          "creation": {
            "on": "craft",
            "to": "completion",
            "procedure": "craftingRoll",
            "branches": {
              "interrupted": "suspended",
              "rushed": "completionWithFlaw"
            }
