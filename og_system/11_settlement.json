{
  "settlement": {
    "state_machines": {
      "downtime": {
        "states": [
          "arrival",
          "activity",
          "event",
          "departure"
        ],
        "initial": "arrival",
        "transitions": {
          "arrival": {
            "on": "enter",
            "to": "activity",
            "procedure": "settleIn"
          },
          "activity": {
            "on": "declare",
            "to": "event",
            "branches": {
              "train": "trainingProcedure",
              "carouse": "carousingProcedure",
              "craft": "craftingModule",
              "recruit": "recruitmentProcedure",
              "research": "researchProcedure",
              "rest": "restProcedure",
              "invest": "investmentProcedure"
            }
          },
          "event": {
            "on": "resolve",
            "to": "activity",
            "branches": {
              "continue": "activity",
              "trouble": "troubleProcedure",
              "opportunity": "opportunityProcedure",
              "depart": "departure"
            }
          },
          "departure": {
            "on": "leave",
            "to": null,
            "procedure": "settlementConsequences"
          }
        }
      }
    },
