digraph TradeMachine {
label=TradeMachine;
fontname=Arial;
fontsize="10pt";
rankdir=LR;
compound=true;
subgraph trademachine_anchor_initial {
label="";
peripheries=0;
margin=0;
trademachine_anchor [label="", shape=point, style=filled, fontsize="1pt", fixedsize=true, width=0.2, height=0.2, fillcolor=black];
}
subgraph cluster_trademachine_anchor_atomic {
label="";
peripheries=0;
cluster=true;
awaiting [label=Awaiting, shape=rectangle, style="rounded, filled", fontname=Arial, fontsize="10pt", peripheries=1, penwidth=2, fillcolor=turquoise];
countering [label=Countering, shape=rectangle, style="rounded, filled", fontname=Arial, fontsize="10pt", peripheries=1, fillcolor=white];
completed [label="Completed\nentry / on_enter_completed", shape=rectangle, style="rounded, filled", fontname=Arial, fontsize="10pt", peripheries=2, fillcolor=white];
}
trademachine_anchor -> awaiting [label="", color=blue, fontname=Arial, fontsize="9pt"];
awaiting -> completed [label=confirm, color=blue, fontname=Arial, fontsize="9pt", minlen=1];
awaiting -> countering [label="offer\n[price_too_low]", color=blue, fontname=Arial, fontsize="9pt", minlen=1];
awaiting -> completed [label="offer\n[price_acceptable]", color=blue, fontname=Arial, fontsize="9pt", minlen=1];
countering -> completed [label=confirm, color=blue, fontname=Arial, fontsize="9pt", minlen=1];
countering -> countering [label="offer\n[price_too_low]", color=blue, fontname=Arial, fontsize="9pt", minlen=1];
countering -> completed [label="offer\n[price_acceptable]", color=blue, fontname=Arial, fontsize="9pt", minlen=1];
}
