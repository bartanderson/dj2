{
  "name": "EncounterFSM",
  "states": [
    {"name": "initiating", "initial": true, "prompt": "{description}"},
    {"name": "awaiting_choice", "prompt": "{description} What do you do? (fight/flee/parley)"},
    {"name": "resolving_fight", "prompt": "Combat starts!"},
    {"name": "completed", "final": true, "prompt": "Encounter ended."}
  ],
  "events": {
    "next": {
      "transitions": [
        {"from": "initiating", "to": "awaiting_choice", "actions": ["begin_encounter"]}
      ]
    },
    "fight": {
      "transitions": [
        {"from": "awaiting_choice", "to": "resolving_fight", "cond": "fight_possible", "actions": ["start_combat"]}
      ]
    },
    "flee": {
      "transitions": [
        {"from": "awaiting_choice", "to": "completed", "cond": "flee_possible", "actions": ["resolve_flee"]}
      ]
    },
    "parley": {
      "transitions": [
        {"from": "awaiting_choice", "to": "completed", "cond": "parley_possible", "actions": ["resolve_parley"]}
      ]
    },
    "combat_ended": {
      "transitions": [
        {"from": "resolving_fight", "to": "completed"}
      ]
    }
  },
  "guards": {
    "fight_possible": {
      "parameters": {},
      "description": "True if combat can begin."
    },
    "flee_possible": {
      "parameters": {},
      "description": "True if flee attempt succeeds."
    },
    "parley_possible": {
      "parameters": {},
      "description": "True if parley attempt succeeds."
    }
  },
  "actions": {
    "begin_encounter": {
      "parameters": {},
      "context_uses": ["engine"],
      "description": "Emits encounter.started when the machine leaves initiating."
    },
    "start_combat": {
      "parameters": {},
      "context_uses": ["engine"],
      "description": "Emits combat.initiation.triggered; no combat rules run here."
    },
    "resolve_flee": {
      "parameters": {},
      "context_uses": ["engine"],
      "description": "Emits encounter.updated then encounter.ended with outcome=fled."
    },
    "resolve_parley": {
      "parameters": {},
      "context_uses": ["engine"],
      "description": "Emits encounter.updated then encounter.ended with outcome=parleyed."
    }
  }
}
