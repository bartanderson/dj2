{
  "name": "TradeFSM",
  "states": [
    {"name": "awaiting", "initial": true, "prompt": "{item_name} costs {current_price} gp. Say 'yes' or offer a price."},
    {"name": "countering", "prompt": "Offer too low. I want {current_price} gp. Say 'yes' or offer again."},
    {"name": "completed", "final": true, "prompt": "You bought {item_name} for {price} gp."}
  ],
  "events": {
    "confirm": {
      "transitions": [
        {"from": "awaiting", "to": "completed", "actions": ["execute_buy"]},
        {"from": "countering", "to": "completed", "actions": ["execute_buy"]}
      ]
    },
    "offer": {
      "event_args": {"value": 0},
      "transitions": [
        {"from": "awaiting", "to": "countering", "cond": "price_too_low", "actions": ["update_price"]},
        {"from": "countering", "to": "countering", "cond": "price_too_low", "actions": ["update_price"]},
        {"from": "awaiting", "to": "completed", "cond": "price_acceptable", "actions": ["execute_buy"]},
        {"from": "countering", "to": "completed", "cond": "price_acceptable", "actions": ["execute_buy"]}
      ]
    },
    "cancel": {
      "transitions": [
        {"from": "awaiting", "to": "completed"},
        {"from": "countering", "to": "completed"}
      ]
    }
  },
  "guards": {
    "price_too_low": {
      "parameters": {"value": "int"},
      "description": "True if offered value < current_price"
    },
    "price_acceptable": {
      "parameters": {"value": "int"},
      "description": "True if offered value >= current_price"
    }
  },
  "actions": {
    "update_price": {
      "parameters": {"value": "int"},
      "context_updates": ["price"],
      "description": "Store offered price in context['price']"
    },
    "execute_buy": {
      "parameters": {},
      "context_uses": ["engine", "character", "merchant", "item"],
      "description": "Execute purchase transaction"
    }
  }
}