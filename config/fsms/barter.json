{
  "name": "BarterFSM",
  "states": [
    {"name": "awaiting", "initial": true, "prompt": "Your {give_item} (worth {give_value} gp) for {receive_item} (worth {receive_value} gp). Need {shortage} more gp. Offer that amount or say 'yes'."},
    {"name": "countering", "prompt": "Need exactly {shortage} gp. Offer that amount or say 'yes'."},
    {"name": "completed", "final": true, "prompt": "Barter completed!"}
  ],
  "events": {
    "confirm": {
      "transitions": [
        {"from": ["awaiting", "countering"], "to": "completed", "actions": ["execute_barter"]}
      ]
    },
    "offer": {
      "event_args": {"value": 0},
      "transitions": [
        {"from": "awaiting", "to": "countering", "cond": "need_more_gold", "actions": ["add_gold"]},
        {"from": "countering", "to": "countering", "cond": "need_more_gold", "actions": ["add_gold"]}
      ]
    },
    "cancel": {
      "transitions": [
        {"from": ["awaiting", "countering"], "to": "completed"}
      ]
    }
  },
  "guards": {
    "need_more_gold": {
      "parameters": {"value": "int"},
      "description": "True if offered value < shortage"
    }
  },
  "actions": {
    "add_gold": {
      "parameters": {"value": "int"},
      "context_updates": ["offered_extra", "shortage"],
      "description": "Adds extra gold and reduces shortage."
    },
    "execute_barter": {
      "parameters": {},
      "context_uses": ["engine", "character", "merchant", "give_item_obj", "receive_item_obj", "offered_extra"],
      "description": "Executes the barter transaction."
    }
  }
}